# Copy to .env for local development. .env is gitignored and must never be
# committed. On a hosting platform, set these in that platform's own
# environment/secrets UI instead of in a file.

# Narrator: demo (default, deterministic, offline) | google | ollama
LOOKLAB_MODEL=demo
LOOKLAB_MODEL_NAME=gemini-3.1-flash-lite

# Comma-separated Gemini API keys. LookLab rotates across them and fails over
# on quota errors, so several keys behave like one reliable one.
# Only needed when LOOKLAB_MODEL=google.
GEMINI_API_KEYS=

# Where the SQLite checkpointer and store live. Defaults to ./data.
# LOOKLAB_CHECKPOINT_PATH=data/checkpoints.sqlite
# LOOKLAB_STORE_PATH=data/store.sqlite

# Seed two demo threads on boot so a cold start is not a blank app. 0 to skip.
LOOKLAB_SEED=1
