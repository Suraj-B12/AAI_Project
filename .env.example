# Copy to .env and fill in. .env is gitignored and must never be committed.

# Narrator provider: demo (default, offline) | google | ollama
LOOKLAB_MODEL=demo

# Comma-separated Gemini credentials. LookLab rotates across them and fails
# over on quota/error, so several short-lived keys behave like one durable one.
GEMINI_API_KEYS=

# Model name used when LOOKLAB_MODEL=google
LOOKLAB_MODEL_NAME=gemini-2.0-flash
